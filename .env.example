# --- Database (Postgres) ---
# Coolify: point this at the attached Postgres service.
DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio

# --- Payload ---
# Generate a strong random string (e.g. `openssl rand -base64 32`).
PAYLOAD_SECRET=change-me-to-a-long-random-string

# --- Public URL of the deployed site (no trailing slash) ---
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
