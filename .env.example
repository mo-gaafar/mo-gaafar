# --- Database (Postgres) ---
# Coolify: point this at the attached Postgres service.
DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio

# --- Payload ---
# Generate a strong random string (e.g. `openssl rand -base64 32`).
PAYLOAD_SECRET=change-me-to-a-long-random-string

# --- Public URL of the deployed site (no trailing slash) ---
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- MCP (Model Context Protocol) server ---
# The CMS is exposed to MCP clients at POST/GET /api/mcp (Streamable HTTP).
# Set DISABLE_MCP=true to turn the endpoint off entirely.
# DISABLE_MCP=false

# --- Media storage: Cloudflare R2 (S3-compatible) ---
# REQUIRED in production: container disks are ephemeral, so uploads must live in
# object storage. Leave S3_BUCKET unset locally to use disk storage instead.
# Create an R2 bucket + an R2 API token (Account → R2 → Manage API Tokens).
# S3_BUCKET=mngaafar-media
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
